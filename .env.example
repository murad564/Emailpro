# PostgreSQL connection string (Render/Railway/Supabase/Neon all provide one)
DATABASE_URL=postgres://user:password@host:5432/aristokrat_mail
# Random string, 24+ characters. Signs sessions and encrypts the stored Brevo API key. Never change it after go-live.
APP_SECRET=change-me-to-a-long-random-string
# First administrator (created only when the database has no users)
ADMIN_EMAIL=admin@aristokrat.az
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Nizami Hasanov
# Public https address of the app (used for Brevo webhooks and image links). Set automatically on Render.
APP_URL=
# Optional: set the Brevo key here instead of in the app's Brevo Integration page
# BREVO_API_KEY=xkeysib-...
# Optional: "Continue with Google" sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type Web application)
# Authorized redirect URI: https://<your-app-address>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: let anyone with an email at these domains sign in with Google as a team member (otherwise only users added by an admin)
# GOOGLE_ALLOWED_DOMAINS=aristokrat.az
